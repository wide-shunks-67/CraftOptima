# ─────────────────────────────────────────────────────
#  CraftOptima — Environment Configuration Template
#  Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────

# Google GenAI API key (for Gemma 4 inference)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key (for neural voice TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID (default: Rachel – 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name
MONGODB_DB_NAME=craftoptima_db
